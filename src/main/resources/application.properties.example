app.version=0.3-dev

vaadin.launch-browser=true

spring.application.name=erp
#spring.devtools.restart.enabled=true
spring.devtools.restart.enabled=false

spring.devtools.restart.poll-interval=2s
spring.devtools.restart.quiet-period=1s

server.servlet.session.persistent=true

spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:5432/${DB_NAME}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASS}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080

# uma vez inicializado, remover essas linhas
app.admin-user.createNewUser=true
app.admin-user.name=Usuário Adiministração
app.admin-user.loginName=userAdmin
app.admin-user.password=uomx